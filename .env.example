# Local development uses a built-in database in server/silhouette-data; no setup needed.
# In production, set DATABASE_URL to a Postgres connection string (e.g. from Neon).
DATABASE_URL=
JWT_SECRET=change-me-to-64-random-hex-characters
PORT=3001
# AI try-on ("Make it real"). Get a key at https://aistudio.google.com/apikey. Empty = off.
GEMINI_API_KEY=
# Optional: a different Gemini image model.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Daily caps (per user, and whole site) to keep costs predictable.
TRYON_PER_USER_DAILY=15
TRYON_DAILY_LIMIT=200
